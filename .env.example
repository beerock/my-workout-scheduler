# ===================================
# Site Configuration
# ===================================
# Production URL for email verification and password reset links
# Leave empty for auto-detection (uses VERCEL_URL in Vercel, localhost in dev)
# For production, set to: https://my-workout-scheduler.vercel.app
# For local dev, can leave empty or set to: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ===================================
# Supabase Configuration
# ===================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===================================
# Security & Encryption
# ===================================
# Encryption Key (for gym credentials)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_here

# ===================================
# Automation & Events
# ===================================
# Inngest Configuration (for event-driven booking automation)
# Get these from https://www.inngest.com/ after creating an account
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# ===================================
# Email Provider
# ===================================
# Resend API Key (for booking notifications and Supabase SMTP)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email sender address (must be verified domain in Resend)
# Example: noreply@yourdomain.com
RESEND_FROM_EMAIL=noreply@beerock.com
