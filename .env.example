# ==============================================================================
# My Workout Scheduler - Environment Variables
# ==============================================================================
#
# IMPORTANT: Copy this file to `.env.local` for local development
# NEVER commit `.env.local` to version control (already in .gitignore)
#
# For detailed setup instructions, see: docs/ENVIRONMENT_VARIABLES_STRATEGY.md
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION
# ------------------------------------------------------------------------------

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (⚠️ SENSITIVE - Server-side only, never expose to client)
# Used for: Admin operations, bypassing RLS in server actions
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Database Password (⚠️ SENSITIVE - Server-side only)
# Used for: Database backups via pg_dump (npm run backup)
# Get from: Supabase Dashboard → Settings → Database → Database password section
# Note: Click "Reset database password" and copy it immediately (only shown once!)
# SUPABASE_DB_PASSWORD=your_database_password_here

# ------------------------------------------------------------------------------
# 2. SECURITY
# ------------------------------------------------------------------------------

# Encryption Key (⚠️ SENSITIVE - Server-side only)
# Used for: Encrypting gym credentials in database (AES-256-GCM)
# Generate with: openssl rand -base64 32
# IMPORTANT: Use DIFFERENT keys for dev/preview/production environments
ENCRYPTION_KEY=your_encryption_key_here

# ------------------------------------------------------------------------------
# 3. EVENT AUTOMATION
# ------------------------------------------------------------------------------

# Inngest Configuration (for event-driven booking automation)
# Get these from: https://www.inngest.com/ → Your App → Settings → Keys
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE
# ------------------------------------------------------------------------------

# Resend API Key (⚠️ SENSITIVE - Server-side only)
# Get from: https://resend.com/dashboard → API Keys → Create API Key
# Used for: Booking notifications, auth emails (via Supabase SMTP)
# Free tier: 3,000 emails/month (sufficient for MVP)
RESEND_API_KEY=your_resend_api_key_here

# Email Configuration (optional, defaults provided)
# From address (must be from verified domain in production)
# Development: Use onboarding@resend.dev for testing (Resend's official test sender)
# Production: Use noreply@beerock.com (verify domain in Resend first)
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=My Workout Scheduler

# ------------------------------------------------------------------------------
# 5. SITE URL CONFIGURATION
# ------------------------------------------------------------------------------

# Site URL (OPTIONAL - only set in production)
#
# How URL resolution works:
# 1. NEXT_PUBLIC_SITE_URL (explicit override) - set this in production
# 2. VERCEL_URL (auto-injected by Vercel) - works in preview/production
# 3. http://localhost:3000 (fallback) - works in local development
#
# When to set:
# - Production: Set to https://my-workout-scheduler.vercel.app
# - Preview/Dev: Leave unset (auto-detection works)
#
# Usage: Email links, auth redirects, API callbacks
# NEXT_PUBLIC_SITE_URL=https://my-workout-scheduler.vercel.app

# ------------------------------------------------------------------------------
# 6. OPTIONAL / FUTURE SERVICES
# ------------------------------------------------------------------------------

# Monitoring & Error Tracking (not yet implemented)
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Analytics (not yet implemented)
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Feature Flags (not yet implemented)
# NEXT_PUBLIC_FEATURE_FLAGS={"newDashboard":false,"emailNotifications":true}

# Rate Limiting / Caching (not yet implemented)
# UPSTASH_REDIS_URL=your_upstash_redis_url_here
# UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# OAuth Providers (not yet implemented)
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GITHUB_CLIENT_ID=your_github_client_id_here
# GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Admin Notifications (not yet implemented)
# SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# ------------------------------------------------------------------------------
# DEVELOPMENT / DEBUGGING
# ------------------------------------------------------------------------------

# Puppeteer Configuration
# Set to true when deploying to Vercel (prevents downloading Chrome in build)
# PUPPETEER_SKIP_DOWNLOAD=true

# Debug Logging (optional, local development only)
# DEBUG=true
# LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# QUICK START CHECKLIST
# ------------------------------------------------------------------------------
#
# For local development:
# 1. Copy this file to `.env.local`
# 2. Fill in required variables (sections 1-4)
# 3. Generate ENCRYPTION_KEY: openssl rand -base64 32
# 4. Run: npm run dev
#
# For Vercel deployment:
# 1. Go to Vercel Dashboard → Your Project → Settings → Environment Variables
# 2. Add required variables for each environment (Development, Preview, Production)
# 3. Use DIFFERENT secrets for production (especially ENCRYPTION_KEY)
# 4. Set NEXT_PUBLIC_SITE_URL only in Production environment
# 5. Enable "Sensitive" checkbox for all ⚠️ SENSITIVE variables
#
# For detailed setup: docs/ENVIRONMENT_VARIABLES_STRATEGY.md
#
# ------------------------------------------------------------------------------
