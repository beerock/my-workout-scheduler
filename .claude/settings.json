{
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-env-edits.js",
            "statusMessage": "Checking for .env file edits"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-lock-files.js",
            "statusMessage": "Checking for lock file edits"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auto-lint.js",
            "statusMessage": "Running lint check"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/auto-typecheck.js",
            "statusMessage": "Running type check"
          }
        ]
      }
    ]
  }
}
